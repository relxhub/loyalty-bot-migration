{
  "name": "loyalty-bot",
  "version": "1.0.0",
  "description": "Telegram Loyalty Bot",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "postinstall": "prisma generate && (simple-git-hooks || echo 'skip simple-git-hooks (no .git/ — likely CI)')",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "simple-git-hooks": {
    "pre-commit": "npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.4.1",
    "form-data": "^4.0.5",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.8.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.5",
    "prisma": "^5.9.1",
    "simple-git-hooks": "^2.13.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^4.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
